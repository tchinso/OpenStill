{
  "manifest_version": 3,
  "name": "OpenStill",
  "short_name": "OpenStill",
  "version": "0.5.0",
  "description": "선택한 웹페이지 요소의 텍스트·링크 변경을 로컬에서 추적합니다.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "action": {
    "default_title": "OpenStill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "scripting",
    "notifications",
    "offscreen",
    "unlimitedStorage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
